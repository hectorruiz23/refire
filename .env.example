# Claves y ajustes por máquina. Copia este fichero a .env (que no se versiona) o a
# ~/.config/refire/env y rellena lo que necesites. Ninguno de los dos viaja en el repo.

# Clave del proveedor del modelo: la que nombre `api_key_env` dentro de voicekit.toml.
OPENCODE_GO_API_KEY=

# Comando que consulta al modelo. Sin esto el escenario cae a la reserva local y los
# drills no se generan; con `{prompt}` se sustituye ahí, si no va como último argumento.
# REFIRE_AGENT_CMD=llm -m gpt-5 {prompt}

# Ruta alternativa del TOML del motor de voz (por defecto ~/.config/refire/voicekit.toml).
# REFIRE_VOICEKIT=/ruta/a/tu/voicekit.toml

# Prompt del escenario: el tuyo, con tu nivel y tu profesión. Por defecto
# ~/.config/refire/scenario.md; si no existe la app usa prompts/scenario.example.md.
# REFIRE_SCENARIO_PROMPT=~/.config/refire/scenario.md
